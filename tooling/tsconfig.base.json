{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "isolatedModules": true, "resolveJsonModule": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true
  }
}

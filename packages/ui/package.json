{
  "name": "@kit/ui",
  "version": "0.3.0",
  "description": "Accessible, token-driven React components with light/dark theming",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "codemods/*.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "size": "size-limit && node scripts/check-css-size.mjs",
    "deploy:storybook": "pnpm build && pnpm build-storybook && pnpm --filter @kit/demo exec wrangler deploy --config ../../packages/ui/wrangler.jsonc",
    "deploy:storybook:dry-run": "pnpm build && pnpm build-storybook && pnpm --filter @kit/demo exec wrangler deploy --config ../../packages/ui/wrangler.jsonc --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.0",
    "jscodeshift": "^17.4.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sirv-cli": "^3.0.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.7",
    "tsup": "^8.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vitest-axe": "^0.1.0"
  },
  "size-limit": [
    {
      "name": "ESM entry (react external)",
      "path": "dist/index.js",
      "limit": "4 kB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom"
      ]
    }
  ],
  "author": "Krisna Dwipayana",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "design-system",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krisyana/web-platform-kit.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/krisyana/web-platform-kit#readme"
}

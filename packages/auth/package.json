{
  "name": "@kit/auth",
  "version": "0.1.0",
  "description": "OIDC authorization-code + PKCE backend-for-frontend with HttpOnly session cookies, CSRF protection and refresh rotation",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0"
  },
  "author": "Krisna Dwipayana",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "oidc",
    "oauth2",
    "pkce",
    "bff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krisyana/web-platform-kit.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/krisyana/web-platform-kit#readme"
}
